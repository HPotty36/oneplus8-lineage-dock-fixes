+/*
+ * A root port can lose its device in the middle of enumeration (e.g. a USB-C
+ * power role swap briefly drops VBUS to a dock) and see it come back without
+ * a further connect-change event, leaving the device present but never
+ * enumerated. Re-check such ports once things have settled.
+ */
+#define HUB_RESCAN_DELAY_MS	1500
+#define HUB_RESCAN_MAX		3
+
+static void hub_rescan_work(struct work_struct *work)
+{
+	struct usb_hub *hub = container_of(to_delayed_work(work),
+					   struct usb_hub, rescan_work);
+	int port1;
+
+	for (port1 = 1; port1 <= USB_MAXCHILDREN; port1++)
+		if (test_and_clear_bit(port1, hub->rescan_bits))
+			set_bit(port1, hub->change_bits);
+
+	kick_hub_wq(hub);
+}
+
+static void hub_schedule_rescan(struct usb_hub *hub, int port1)
+{
+	if (hub->disconnected || hub->rescan_count >= HUB_RESCAN_MAX)
+		return;
+
+	hub->rescan_count++;
+	set_bit(port1, hub->rescan_bits);
+	dev_info(&hub->ports[port1 - 1]->dev,
+		 "enumeration interrupted, re-checking port in %d ms\n",
+		 HUB_RESCAN_DELAY_MS);
+	mod_delayed_work(system_wq, &hub->rescan_work,
+			 msecs_to_jiffies(HUB_RESCAN_DELAY_MS));
+}
